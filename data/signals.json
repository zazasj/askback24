  ],
  "K-MOCK-0005": [
    { "text": "최근 12개월 가입자 수가 프로젝트 시기에 따라 오르내렸어요", "source": "실제", "source_name": "국민연금 사업장 가입자 현황" },
    { "text": "임금체불 명단공개 대상에는 올라 있지 않아요", "source": "모의", "source_name": "임금체불 사업주 명단" }
