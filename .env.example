# 서버 함수(api/)용. 실제 값은 .env 또는 Vercel 환경변수에만 둔다(커밋 금지).
# mock(기본, 가짜 공급자) · remote(같은 배포의 Python AI 서버, docs/AI-API-명세서.md). 모르는 값이면 mock
LLM_PROVIDER=mock
# remote 일 때: Python AI 서버 주소(/v1/… 앞부분). 배포에서는 비우면 https://${VERCEL_URL}/api/ai(D-314). AI_API_KEY 는 TS·Python 이 같은 값을 Bearer 로 씀
AI_ENDPOINT=
AI_API_KEY=
# Python AI 서버(api/ai, api/_agent)만 읽는다. 엔노이아 멀티 에이전트(D-308)
ENNOIA_PROJECT=
ENNOIA_API_KEY=
# 역할별 에이전트 ID(콘솔에서 모델을 정함). 없으면 ENNOIA_AGENT_ID 하나를 쓴다
ENNOIA_AGENT_ID=
ENNOIA_AGENT_ID_FAST=
ENNOIA_AGENT_ID_ACCURATE=

# data.go.kr 일반 인증키 — Python ①(국민연금 가입 사업장 내역)·⓪(NCS 정보_GW)이 읽는다(D-322·D-325)
DATA_GO_KR_KEY=

# 회사 신호 시연 매핑(D-318): 시연 공고 번호 → 실제 사업장명·사업자번호(10자리) JSON 한 줄. 예:
# REAL_COMPANY_MAP={"K-MOCK-0001":{"name":"<실제 사업장명>","bizNo":"<사업자번호>"},"K-MOCK-0002":{…}}
# 팀(세진) 확인 전에는 비워 둔다(D-321). 비어 있으면 시연 모의 값을 쓴다. 로그·응답·data/에 남기지 않는다
REAL_COMPANY_MAP=

# 고용24 오픈API 키 — scripts/fetch-work24(npm run fetch:work24)가 읽는다. DUTY·JOB·COMMONCODE는 Python ⓪도 읽어 Vercel에도 둔다(D-325), SMALLGIANT는 로컬만
WORK24_KEY_DUTY=
WORK24_KEY_JOB=
WORK24_KEY_COMMONCODE=
WORK24_KEY_SMALLGIANT=
