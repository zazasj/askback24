# 서버 함수(api/)용. 실제 값은 .env 또는 Vercel 환경변수에만 둔다(커밋 금지).
# mock(기본, 가짜 공급자) · remote(AI 담당 서버, docs/API-SPEC.md) · ennoia(자리만). 모르는 값이면 mock
LLM_PROVIDER=mock
# remote 일 때: AI 담당 서버 주소(/v1/… 앞부분, 예: https://ai.example.com)와 Authorization: Bearer 값
AI_ENDPOINT=
AI_API_KEY=
# 엔노이아 자리(이번 범위에서 뺌, D-110). 값이 있어도 부르지 않는다
ENNOIA_API_KEY=
ENNOIA_ENDPOINT=

# 고용24 오픈API 키 — scripts/fetch-work24(npm run fetch:work24)만 읽는다. 로컬 .env에만, Vercel에는 넣지 않는다
WORK24_KEY_DUTY=
WORK24_KEY_JOB=
WORK24_KEY_COMMONCODE=
WORK24_KEY_SMALLGIANT=
