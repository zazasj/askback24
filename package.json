{
  "name": "askback24",
  "private": true,
  "version": "0.1.0",
  "description": "고용24 해커톤(레인보우 가이즈) — 구직자 면접 역질문 준비 서비스 시연 사이트",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc --noEmit && vite build",
    "build:mock": "vue-tsc --noEmit && vite build --mode mock",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "screens": "playwright test e2e/screens.spec.ts",
    "check": "npm run build && npm run test:unit && npm run test:e2e",
    "fetch:work24": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/fetch-work24.ts"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "krds-uiux": "^1.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
